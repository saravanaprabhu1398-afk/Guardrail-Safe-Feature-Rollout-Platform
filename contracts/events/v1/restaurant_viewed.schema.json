{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardrail.dev/contracts/events/v1/restaurant_viewed.schema.json",
  "title": "Restaurant viewed event v1",
  "x-guardrail-event-name": "restaurant_viewed",
  "x-guardrail-event-version": 1,
  "allOf": [
    { "$ref": "../common/product-event-envelope.v1.schema.json" },
    {
      "properties": {
        "event_name": { "const": "restaurant_viewed" },
        "attributes": {
          "type": "object",
          "required": ["restaurant_id", "rank", "query_id"],
          "additionalProperties": false,
          "properties": {
            "restaurant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "rank": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "query_id": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardrail.dev/contracts/events/v1/order_completed.schema.json",
  "title": "Order completed event v1",
  "x-guardrail-event-name": "order_completed",
  "x-guardrail-event-version": 1,
  "allOf": [
    { "$ref": "../common/product-event-envelope.v1.schema.json" },
    {
      "properties": {
        "event_name": { "const": "order_completed" },
        "attributes": {
          "type": "object",
          "required": ["order_id", "order_amount", "currency"],
          "additionalProperties": false,
          "properties": {
            "order_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "order_amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          }
        }
      }
    }
  ]
}

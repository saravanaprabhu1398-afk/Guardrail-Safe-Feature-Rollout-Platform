# Phase 1 runs without environment variables. These placeholders prepare Phase 2.
GUARDRAIL_ENV=local
GUARDRAIL_EVENT_TRANSPORT=snowpipe

REDPANDA_BOOTSTRAP_SERVERS=localhost:19092
REDPANDA_TOPIC=guardrail.product-events.v1
REDPANDA_CLIENT_ID=guardrail-api
REDPANDA_CONSUMER_GROUP=guardrail-snowpipe-sink-v1
REDPANDA_WORKER_BATCH_SIZE=500
REDPANDA_POLL_TIMEOUT_SECONDS=1

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=GUARDRAIL_ENGINEER
SNOWFLAKE_WAREHOUSE=GUARDRAIL_INGEST_WH
SNOWFLAKE_TRANSFORM_WAREHOUSE=GUARDRAIL_TRANSFORM_WH
SNOWFLAKE_DATABASE=GUARDRAIL
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_AUTH_METHOD=PAT
SNOWFLAKE_PAT_FILE=.secrets/snowflake_pat
SNOWFLAKE_STREAMING_PIPE=PRODUCT_EVENTS_STREAMING
SNOWFLAKE_STREAMING_CHANNEL=guardrail-local-dev
